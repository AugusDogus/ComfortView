<Project>
  <Import Project="$(MSBuildThisFileDirectory)Environment.props" Condition="Exists('$(MSBuildThisFileDirectory)Environment.props')" />
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == '' And '$(OS)' == 'Unix'">$(HOME)/.local/share/Steam/steamapps/common/Valheim</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Valheim</GameDir>
    <ManagedDir Condition="'$(ManagedDir)' == '' And Exists('$(GameDir)/Valheim_Data/Managed')">$(GameDir)/Valheim_Data/Managed</ManagedDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(GameDir)/valheim_Data/Managed</ManagedDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(GameDir)/BepInEx</BepInExDir>
  </PropertyGroup>
</Project>
